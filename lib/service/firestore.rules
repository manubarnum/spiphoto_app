rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSpiphotoUser() {
      return request.auth != null
        && request.auth.token.email.matches('.*@spiphoto[.]fr$');
    }

    // Un événement favori par paire {uid}_{mediaId}
    // L'événement et le compteur de sa fiche photoStats bougent ensemble,
    // dans le même lot d'écritures : créer l'événement exige +1 sur le
    // compteur, le supprimer exige -1.
    match /favoriteEvents/{eventId} {
      function fiche(mediaId) {
        return /databases/$(database)/documents/photoStats/$(string(mediaId));
      }

      allow read: if isSpiphotoUser();

      allow create: if isSpiphotoUser()
        && request.resource.data.userId == request.auth.uid
        && eventId == request.auth.uid + '_' + string(request.resource.data.mediaId)
        && (
          (!exists(fiche(request.resource.data.mediaId))
            && getAfter(fiche(request.resource.data.mediaId)).data.favoriteCount == 1) ||
          (exists(fiche(request.resource.data.mediaId))
            && getAfter(fiche(request.resource.data.mediaId)).data.favoriteCount
               == get(fiche(request.resource.data.mediaId)).data.favoriteCount + 1)
        );

      allow delete: if isSpiphotoUser()
        && resource.data.userId == request.auth.uid
        && getAfter(fiche(resource.data.mediaId)).data.favoriteCount
           == get(fiche(resource.data.mediaId)).data.favoriteCount - 1;

      allow update: if false; // jamais de modif, seulement create/delete
    }

    // Fiche par photo : compteur agrégé et données du fil du Club
    match /photoStats/{mediaId} {
      // Seuls ces champs existent ; chaque membre ne touche qu'à sa propre
      // entrée membres.{uid}.
      function champsConnus() {
        return request.resource.data.keys().hasOnly(['favoriteCount',
          'lastAddedAt', 'photoPath', 'vignettePath', 'ecranPath', 'albumTitle',
          'membres']);
      }

      // Événement favori du membre connecté pour cette photo.
      function evenement() {
        return /databases/$(database)/documents/favoriteEvents/$(request.auth.uid + '_' + mediaId);
      }

      allow read: if isSpiphotoUser();

      allow create: if isSpiphotoUser()
        && request.resource.data.favoriteCount == 1
        && !exists(evenement()) && existsAfter(evenement())
        && champsConnus()
        && request.resource.data.get('membres', {}).keys()
          .hasOnly([request.auth.uid]);

      allow update: if isSpiphotoUser()
        && request.resource.data.favoriteCount >= 0
        && (
          // +1 : l'événement du membre est créé dans ce lot
          (request.resource.data.favoriteCount == resource.data.favoriteCount + 1
            && !exists(evenement()) && existsAfter(evenement())) ||
          // -1 : l'événement du membre est supprimé dans ce lot
          (request.resource.data.favoriteCount == resource.data.favoriteCount - 1
            && exists(evenement()) && !existsAfter(evenement()))
        )
        && champsConnus()
        && request.resource.data.get('membres', {})
          .diff(resource.data.get('membres', {})).affectedKeys()
          .hasOnly([request.auth.uid]);

      allow delete: if false;
    }

    // Ancienne collection : plus utilisée, on ferme tout
    match /favorites/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}