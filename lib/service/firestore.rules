rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSpiphotoUser() {
      return request.auth != null
        && request.auth.token.email.matches('.*@spiphoto[.]fr$');
    }

    // Un événement favori par paire {uid}_{mediaId}
    match /favoriteEvents/{eventId} {
      allow read: if isSpiphotoUser();

      allow create: if isSpiphotoUser()
        && request.resource.data.userId == request.auth.uid
        && eventId == request.auth.uid + '_' + string(request.resource.data.mediaId);

      allow delete: if isSpiphotoUser()
        && resource.data.userId == request.auth.uid;

      allow update: if false; // jamais de modif, seulement create/delete
    }

    // Fiche par photo : compteur agrégé et données du fil du Club
    match /photoStats/{mediaId} {
      // Seuls ces champs existent ; chaque membre ne touche qu'à sa propre
      // entrée membres.{uid}.
      function champsConnus() {
        return request.resource.data.keys().hasOnly(['favoriteCount',
          'lastAddedAt', 'photoUrl', 'vignetteUrl', 'ecranUrl', 'albumTitle',
          'membres']);
      }

      allow read: if isSpiphotoUser();

      allow create: if isSpiphotoUser()
        && request.resource.data.favoriteCount == 1
        && champsConnus()
        && request.resource.data.get('membres', {}).keys()
          .hasOnly([request.auth.uid]);

      allow update: if isSpiphotoUser()
        && request.resource.data.favoriteCount >= 0
        && (
          request.resource.data.favoriteCount == resource.data.favoriteCount + 1 ||
          request.resource.data.favoriteCount == resource.data.favoriteCount - 1
        )
        && champsConnus()
        && request.resource.data.get('membres', {})
          .diff(resource.data.get('membres', {})).affectedKeys()
          .hasOnly([request.auth.uid]);

      allow delete: if false;
    }

    // Ancienne collection : plus utilisée, on ferme tout
    match /favorites/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}